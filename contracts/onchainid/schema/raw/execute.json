{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecuteMsg",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "add_claim"
      ],
      "properties": {
        "add_claim": {
          "type": "object",
          "required": [
            "issuer",
            "topic"
          ],
          "properties": {
            "data": {
              "type": [
                "string",
                "null"
              ]
            },
            "expires_at": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0.0
            },
            "issuer": {
              "type": "string"
            },
            "topic": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "revoke_claim"
      ],
      "properties": {
        "revoke_claim": {
          "type": "object",
          "required": [
            "claim_id",
            "topic"
          ],
          "properties": {
            "claim_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "topic": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "update_owner"
      ],
      "properties": {
        "update_owner": {
          "type": "object",
          "required": [
            "owner"
          ],
          "properties": {
            "owner": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
